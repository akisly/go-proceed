# ═══════════════════════════════════════════════════════════════════════════
# apps/mobile — the Expo field client (v0.2 Plan C pilot, web-first).
#
# All three vars are EXPO_PUBLIC_*, which Metro inlines into the bundle at
# build time — see the comment at the top of src/lib/env.ts on why every read
# of one of these must stay literal dot-notation (`process.env.EXPO_PUBLIC_…`).
# Unlike apps/app/.env.example there is no build-time/runtime split to call
# out here: everything this client reads is public by necessity (it ships
# inside the app bundle) and there is no server half of this app to hold a
# runtime secret.
#
# The values below are this repo's fixed local dev stack (`supabase start`'s
# deterministic output, same defaults `apps/app/qa/field.mjs` and
# `apps/app/.env.example` document) — not secrets, and safe to commit here.
# ═══════════════════════════════════════════════════════════════════════════

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The `sb_publishable_…` key — Project Settings → API → "Publishable key" on a
# real project; the local CLI's fixed dev value below on this stack. Safe to
# ship inside a bundle: RLS is the security boundary, not this value (same key
# family apps/app/.env.example documents; the legacy `anon` JWT form stops
# working at the end of 2026).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The origin src/lib/api.ts's apiGet/apiPost call — apps/app's Next server.
# Same host+port `next dev`/`next start` binds to locally.
EXPO_PUBLIC_API_ORIGIN=http://localhost:3000
