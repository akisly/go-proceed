NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 'app_pw' is a LOCAL-ONLY password set by supabase/seed.sql (never by a
# migration, so it can never reach staging/prod via `supabase db push`).
# aktflow_app membership is full tenant-table access — staging/prod must use
# a freshly generated secret, never this value. See infra/README-staging.md §2.
APP_DB_URL=postgresql://aktflow_app_login:app_pw@127.0.0.1:54322/postgres
