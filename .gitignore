# Prototype build + QA scratch (qa-screenshots/ IS tracked — validate_package.py:2404 requires them)
prototype/dist/
prototype/qa-runtime-tmp/

# Claude Code native worktrees (never commit worktree contents)
.claude/worktrees/

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# apps/app's browser QA pass (qa/field.mjs): the report, screenshots and the
# throwaway JPEG fixture it writes for the capture-flow assertion all land
# here, so a QA run never dirties tracked files — CI's app-qa job asserts the
# tree is clean after one.
apps/app/qa-output/

# apps/mobile's browser QA pass (qa/field-web.mjs): same convention as
# apps/app/qa-output/ above — the report, screenshots and the throwaway JPEG
# fixture land here. `dist/` (the `expo export --platform web` output the
# harness serves) is already covered by apps/mobile/.gitignore's own `dist/`
# entry; listed again here too since CI's clean-tree checks run from the
# repo root, not from apps/mobile.
apps/mobile/qa-output/
apps/mobile/dist/

# apps/landing/qa/landing.mjs writes screenshots and report.json here on every
# run — the same reasoning as apps/mobile above.
apps/landing/qa-output/

# Child B discovery — personal data under ЗУ «Про захист персональних даних» (doc 40 §B.5)
discovery/leads.csv
discovery/outreach-log.csv
discovery/suppression.csv
discovery/drafts/
discovery/*.db
.gstack/

# Agent-session screenshots and briefs; DEV-007 removed the tracked copy (2026-09-14).
/output/
apps/app/qa-output-before/
