{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@goproceed/app",
        "exec",
        "next",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@goproceed/landing",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": true
    }
  ]
}
