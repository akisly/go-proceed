{"kind":"table","sheet":"Dashboard","address":"A1:N25","rows":25,"cols":14,"values":[["GoProceed — prospecting cockpit",null,null,null,null,null,null,null,null,null,null,null,null,null],["Знімок 24.08.2026 • 101 акаунт • мета: перевести публічний fit у розмови, артефакти та безкоштовні design-partner пілоти",null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Ключові показники воронки",null,null,null,null,null,null,null,null,null,null,null,null,null],["Усього акаунтів","Нова хвиля 24.08","Підтверджені відправки","Пріоритет A","Пріоритет B","Підтриманий трек зараз",null,null,null,null,null,null,null,null],[101,51,21,58,7,66,null,null,null,null,null,null,null,null],["База для системної кваліфікації","Офіційні сайти / портфоліо","21 відправка; 0 відповідей за даними журналу","Найкращий fit + покриття","Добрий fit / перевірити","Н.14, Н.15 або обидва",null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Портфель за пілотним треком",null,null,null,null,null,null,null,null,null,null,null,null,null],["Пілотний трек","Акаунти","Пріоритет A",null,null,null,null,null,null,null,null,null,null,null],["Зараз — Н.15",42,25,null,null,null,null,null,null,null,null,null,null,null],["Зараз — Н.14",18,14,null,null,null,null,null,null,null,null,null,null,null],["Зараз — Н.14 + Н.15",6,4,null,null,null,null,null,null,null,null,null,null,null],["Перевірити — Н.15",25,15,null,null,null,null,null,null,null,null,null,null,null],["Пізніше — вимоги проєкту",8,0,null,null,null,null,null,null,null,null,null,null,null],["Перекваліфікувати",2,0,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null],["Рекомендована послідовність дій",null,null,null,null,null,null,null,null,null,null,null,null,null],["1","Сьогодні","21 follow-up","Надіслати наявним адресатам персональне посилання без реєстрації. Одна дія: прийняти / повернути.",null,null,null,null,null,null,null,null,null,null],["2","Дні 1–3","10 нових A","Персоналізувати перший рядок за публічним доказом. Не продавати платформу — попросити оцінити конкретний review-flow.",null,null,null,null,null,null,null,null,null,null],["3","Дні 3–7","Артефакт","Після будь-якої реакції попросити 1 анонімізований акт/АВР або фото прихованої роботи та провести 20-хвилинне інтерв’ю.",null,null,null,null,null,null,null,null,null,null],["4","Дні 7–10","Пілот","Запропонувати 30–45 днів без ліцензійної плати на одному проєкті з названим спонсором, ПТО, майстром і рев’юером.",null,null,null,null,null,null,null,null,null,null],["5","Щоп’ятниці","Рішення","Продовжувати сегмент лише якщо з’являються відповіді, артефакти та доступ до реального проєкту. Інакше змінювати повідомлення або сегмент.",null,null,null,null,null,null,null,null,null,null]]}
