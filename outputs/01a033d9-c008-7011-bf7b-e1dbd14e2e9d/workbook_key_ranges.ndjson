{"kind":"table","sheet":"Pilot Offer","address":"A1:H27","rows":27,"cols":8,"values":[["Безкоштовний design-partner пілот",null,null,null,null,null,null,null],["30–45 днів • один реальний проєкт • без ліцензійної плати • чесне обмеження поточного покриття Н.14 / Н.15",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Пропозиція",null,null,null,null,null,null,null],["GoProceed допомагає спеціалізованій бригаді підготувати виконану роботу до приймання: зібрати фото, прив’язати їх до вимог і передати рев’юеру одну захищену сторінку без створення акаунта. Пілот безкоштовний, бо нам потрібен спільний доказ цінності на реальному процесі, а не “тест системи” без відповідальності.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Вхідні умови",null,null,null,"Що входить",null,null,null],["• Один активний проєкт з внутрішніми сантехнічними / HVAC або електромонтажними роботами.",null,null,null,"• Налаштування одного пілотного процесу та короткий onboarding.",null,null,null],["• Названий спонсор з боку компанії та відповідальні ПТО, майстер і рев’юер.",null,null,null,"• Персональні посилання рев’юеру без пароля / реєстрації.",null,null,null],["• Один реальний анонімізований акт/АВР або приклад пакета доказів до старту.",null,null,null,"• Щотижневий розбір вузьких місць і ручна підтримка засновника.",null,null,null],["• 30 хв щотижня на розбір фактичного процесу.",null,null,null,"• Базові метрики до/після та фінальний висновок про цінність.",null,null,null],["• Дозвіл фіксувати агреговані метрики без розкриття комерційної інформації.",null,null,null,"• Пріоритетне виправлення блокуючих дефектів у межах погодженого сценарію.",null,null,null],["• Рішення go / no-go наприкінці 30–45 днів.",null,null,null,"• Без ліцензійної плати; інтеграції та кастомна розробка не обіцяються.",null,null,null],[null,null,null,null,null,null,null,null],["Метрики успіху",null,null,null,"Стоп-умови",null,null,null],["1. Частка робіт, прийнятих з першого перегляду.",null,null,null,"• Немає активного проєкту або названого спонсора.",null,null,null],["2. Час від готовності бригади до рішення рев’юера.",null,null,null,"• Команда не надає жодного реального артефакту.",null,null,null],["3. Частка доказів, зафіксованих до закриття робіт.",null,null,null,"• Потрібні роботи поза поточним покриттям і немає вимог проєкту.",null,null,null],["4. Кількість повернень через неповні фото / документи.",null,null,null,"• Пілот перетворюється на необмежену кастомну розробку.",null,null,null],["5. Активність майстра, ПТО і рев’юера щотижня.",null,null,null,"• Дві послідовні сесії без участі ключових ролей.",null,null,null],[null,null,null,null,null,null,null,null],["Що не обіцяємо",null,null,null,null,null,null,null],["Захищене посилання не є КЕП або юридичним підписом. Бібліотека вимог поки містить лише 12 пунктів ДБН А.3.1-5:2016 для внутрішніх санітарно-технічних та електромонтажних робіт. Імпорт реальних файлів замовника ще не перевірений на клієнтських даних. Усе інше — предмет discovery, а не гарантія пілоту.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null]]}
--- Outreach ---
{"kind":"table","sheet":"Outreach","address":"A1:H30","rows":30,"cols":8,"values":[["Outreach-пакет",null,null,null,null,null,null,null],["Короткі повідомлення українською • продаємо наступний крок, а не платформу • персоналізація тільки за публічним доказом",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["1. Follow-up для 21 вже надісланого контакту",null,null,null,null,null,null,null],["Доброго дня! Надсилаю коротке продовження — ми спростили перевірку виконаної роботи до однієї сторінки без реєстрації: фото, джерело вимоги та рішення «прийняти / повернути». Ось персональне посилання: [персональне посилання]. Чи схоже це на те, як ваш замовник або технагляд приймає [релевантна робота]? Достатньо відповісти одним реченням.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["2. Перший контакт новому акаунту A",null,null,null,null,null,null,null],["Доброго дня! Побачив, що [компанія] виконує [конкретний публічний доказ: тип робіт / кілька об’єктів / власні бригади]. Ми тестуємо GoProceed для моменту перед закриттям прихованої роботи: бригада збирає докази, а ПТО або замовник переглядає одну сторінку без акаунта. Можу надіслати 40-секундний приклад саме для [релевантна робота]?",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["3. Запит одного реального артефакту після відповіді",null,null,null,null,null,null,null],["Щоб не вигадувати процес за вас: чи можете показати один анонімізований акт/АВР або перелік фото, який ви реально готуєте перед прийманням? Комерційні дані можна закрити. За 20 хвилин розберемо, де виникає повернення або очікування, і скажемо чесно, чи GoProceed тут доречний.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["4. Пропозиція безкоштовного пілоту після кваліфікації",null,null,null,null,null,null,null],["Пропоную design-partner пілот на одному активному проєкті на 30–45 днів без ліцензійної плати. З вашого боку потрібні спонсор, ПТО, майстер, рев’юер, один реальний анонімізований пакет і 30 хв щотижня. Разом виміряємо приймання з першого разу, час до рішення та повернення через неповні докази. Якщо цінності немає — зупиняємося без зобов’язань.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Правила персоналізації",null,null,null,null,null,null,null],["Перший рядок має містити один перевірений факт із колонки «Доказ відповідності». Не згадувати вигадані болі, економію або “автоматизацію всього”. Перша CTA — дозвіл на короткий приклад; друга — один артефакт; пілот пропонується лише після доступу до реального процесу.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null]]}
--- Methodology ---
{"kind":"table","sheet":"Methodology","address":"A1:H19","rows":19,"cols":8,"values":[["Методологія та межі доказів",null,null,null,null,null,null,null],["Скоринг визначає порядок дослідження й контакту — не доводить намір купувати",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Fit score: 0–100",null,null,null,"Пріоритети",null,null,null],["Фактор","Шкала","Вага","Що означає","Клас","Правило","Дія","Сенс"],["Покриття продукту","0–5","×6","Наскільки роботи збігаються з поточними Н.14 / Н.15","A","Score ≥84; покриття ≥4; buyer fit ≥4","Контакт у першій хвилі","Найкраще поєднання fit і чесного покриття"],["Приховані роботи","0–5","×4","Наскільки докази критичні до закриття стель, стін, траншей","B","Score ≥70; покриття ≥3","Друга хвиля / уточнити сценарій","Fit добрий, але потрібна перевірка"],["Масштаб","0–5","×3","Бригади, портфель проєктів, географія, власні ресурси","C","Нижче порогів","Не витрачати founder-time зараз","Слабке покриття або партнерський канал"],["Документація","0–5","×3","Проєктування, ПТО, випробування, акти, введення в експлуатацію","Legacy","Немає повного набору факторів","Повторно дослідити","Старий запис не можна змішувати з перевіреними"],["Доступ до покупця","0–5","×3","Спеціалізований підрядник ближче до власника / ПТО, ніж великий генпідрядник",null,null,null,null],["Досяжність","0–5","×1","Публічний сайт, форма, телефон або зрозумілий маршрут до ролі",null,null,null,null],[null,null,null,null,null,null,null,null],["Джерела й обмеження",null,null,null,null,null,null,null],["• 50 записів імпортовано з aktflow_ukraine_leads_50_demo_outreach_2026-07-28.xlsx; 28 legacy-позицій не мають достатньої публічної перевірки.",null,null,null,null,null,null,null],["• 51 нова компанія перевірена 24.08.2026 за офіційними сайтами / портфоліо; URL збережено в кожному рядку.",null,null,null,null,null,null,null],["• 21 відправка підтверджена попереднім журналом; 0 відповідей, інтерв’ю, названих проєктів або пілотних зобов’язань станом на 30.07.2026.",null,null,null,null,null,null,null],["• Поточна бібліотека: 12 вимог ДБН А.3.1-5:2016 — 5 для Н.14 і 7 для Н.15. Інші роботи не можна обіцяти без вимог конкретного проєкту.",null,null,null,null,null,null,null],["• Публічна відповідність ≠ підтверджений біль, готовність до пілоту або платоспроможність. Наступний рівень доказу — відповідь, артефакт, інтерв’ю, активний проєкт.",null,null,null,null,null,null,null],["• Персональні контакти не збиралися; база працює на рівні компаній, ролей і публічних джерел.",null,null,null,null,null,null,null]]}