{"kind":"table","sheet":"Pilot Offer","address":"A1:F25","rows":25,"cols":6,"values":[["Два безкоштовні офери замість одного",null,null,null,null,null],["Пілот доводить цінність на поточному покритті; discovery sprint перевіряє нову вертикаль без фальшивої обіцянки готового продукту",null,null,null,null,null],[null,null,null,null,null,null],["A. Design-partner пілот — Pilot now",null,null,null,null,"B. Workflow discovery sprint — Expansion"],["30–45 днів на одному активному проєкті без ліцензійної плати. Підходить для внутрішніх сантехнічних/HVAC та електромонтажних робіт у межах погодженого Н.14/Н.15 subset.",null,null,null,null,"2 тижні без ліцензійної плати: розібрати один реальний пакет приймання, вимоги проєкту та ролі. Результат — карта workflow, verdict fit/no-fit і вузький scope майбутнього пілоту."],[null,null,null,null,null,null],[null,null,null,null,null,null],[null,null,null,null,null,null],["Умови входу",null,null,null,null,"Умови входу"],["• Один активний проєкт і названий спонсор.",null,null,null,null,"• Один реальний пакет приймання з нової вертикалі."],["• ПТО, майстер і рев’юер.",null,null,null,null,"• Вимоги / специфікація конкретного проєкту."],["• Один анонімізований акт/АВР або пакет фото.",null,null,null,null,"• 60 хв з виконробом або ПТО."],["• 30 хв щотижня.",null,null,null,null,"• 30 хв з рев’юером / технаглядом."],["• Метрики до/після.",null,null,null,null,"• Дозвіл змоделювати 1 вузький workflow."],["• Go/no-go на 30–45 день.",null,null,null,null,"• Жодної обіцянки інтеграції чи повного покриття."],[null,null,null,null,null,null],["Метрики пілоту",null,null,null,null,"Результат discovery sprint"],["1. Приймання з першого перегляду.",null,null,null,null,"1. Підтверджений або спростований workflow pain."],["2. Час до рішення рев’юера.",null,null,null,null,"2. Список вимог і джерел істини."],["3. Докази до закриття робіт.",null,null,null,null,"3. Карта ролей і handoff."],["4. Повернення через неповний пакет.",null,null,null,null,"4. Один прототип пакета приймання."],["5. Щотижнева активність ролей.",null,null,null,null,"5. Рішення: build / partner / stop."],[null,null,null,null,null,null],["Незмінні межі",null,null,null,null,null],["Захищене посилання не є КЕП. Поточна бібліотека містить 12 вимог: 5 для Н.14 і 7 для Н.15. У нових вертикалях GoProceed не має готового нормативного покриття: пілот можливий лише після отримання вимог конкретного проєкту та погодження вузького scope.",null,null,null,null,null]]}
