{"kind":"table","sheet":"Vertical Map","address":"A1:J64","rows":64,"cols":10,"values":[["Карта 60 сегментних міток",null,null,null,null,null,null,null,null,null],["Розширено за межі санітарно-технічних та електромонтажних робіт; споріднені н...",null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],["Вертикаль","Компаній","Покриття зараз","Workflow fit","Прихованість","Документація","Маршрут","Що закривається","Перший артефакт","Початковий CTA"],["Басейни, водні комплекси та SPA",3,3,5,5,5,"Expansion discovery","Закладні, труби, гідроізоляція","Фото закладних + гідротест","Покажіть пакет до оздоблення чаші"],["Безпека / СКУД / CCTV",80,1,5,4,5,"Expansion discovery","Траси, адресація, налаштування","Виконавча схема + acceptance-test","Покажіть пакет здачі одного об'єкта"],["Безпека + пожежні + слаботочка",1,4,5,4,4,"Expansion discovery","Фото, акти, протоколи та виконавча документація до закриття або ПНР","Один анонімізований пакет приймання з поточного проєкту","Покажіть один пакет: перевіримо fit і запропонуємо вузький безкоштовний пілот"],["Вентильовані фасади та скління",5,0,5,5,4,"Expansion discovery","Анкери, утеплення, мембрани, відсічки","Фото кронштейнів / утеплення","Як технагляд приймає до облицювання?"]],"valuesTruncated":true,"valuesPreviewRows":8,"valuesPreviewCols":10,"valuesPreviewAddress":"A1:J8"}
