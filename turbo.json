{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_APP_ORIGIN",
        "DEPLOY_PREFLIGHT",
        "APP_DB_URL",
        "SERVICE_DB_URL",
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY",
        "EXTERNAL_LINK_ORIGIN",
        "EXTERNAL_LINK_HMAC_KEYS",
        "EXTERNAL_LINK_ACTIVE_KEY_ID",
        "EXTERNAL_SESSION_HMAC_KEYS",
        "EXTERNAL_SESSION_ACTIVE_KEY_ID",
        "FIELD_CLIENT_ORIGINS",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_LINK_HMAC_KEYS",
        "TELEGRAM_LINK_ACTIVE_KEY_ID",
        "TELEGRAM_ERASURE_HMAC_KEYS",
        "TELEGRAM_ERASURE_ACTIVE_KEY_ID",
        "TELEGRAM_CHAT_ID",
        "RESEND_API_KEY",
        "PILOT_TO_EMAIL",
        "PILOT_FROM_EMAIL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "APP_DB_URL",
        "SERVICE_DB_URL",
        "SUPABASE_DB_URL",
        "TEST_DB_ADMIN_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../supabase/migrations/**",
        "../../supabase/seed.sql",
        "../../supabase/config.toml",
        "../../technical/copy-catalog.csv",
        "../../technical/requirements/**",
        "../../packages/tokens/src/tokens.json",
        "../../packages/tokens/scripts/**",
        "../../packages/ui/src/tokens.generated.css",
        "../../packages/tokens/src/tokens.generated.ts",
        "../../apps/mobile/src/lib/status-labels.generated.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID",
        "RESEND_API_KEY",
        "PILOT_TO_EMAIL",
        "PILOT_FROM_EMAIL"
      ]
    }
  }
}
