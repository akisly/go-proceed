{
  "name": "goproceed",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate:canonical-docs": "node scripts/validate-canonical-docs.mjs",
    "db:local-credentials": "node scripts/check-supabase-cli.mjs && node scripts/set-local-app-password.mjs",
    "db:catalog-snapshot": "node scripts/snapshot-db-catalog.mjs",
    "db:check-cli": "node scripts/check-supabase-cli.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "sharp": "0.34.5",
    "turbo": "2.10.11",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
